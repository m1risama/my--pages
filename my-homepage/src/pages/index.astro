    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            /* 背景画像のトランジションを滑らかに */
            transition: background-image 0.5s ease-in-out, background-color 0.5s ease-in-out, color 0.5s ease-in-out;
        }

        /* --- ギミック発動時（.gimmick-active）のスタイル --- */
        
        /* 1. 背景を画像に変更 */
        body.gimmick-active {
            background-image: url('/24517009_l.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #ffffff; /* 全体の基本文字色を白に */
        }

        /* 2. 背景が画像の時は、白いカード背景を半透明の黒にして文字を見やすくする */
        body.gimmick-active .bg-white {
            background-color: rgba(0, 0, 0, 0.6) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }
        
        /* 3. 各種テキストの色を白や明るい色に上書き */
        body.gimmick-active .text-gray-800,
        body.gimmick-active .text-gray-700,
        body.gimmick-active .text-gray-600 {
            color: #f8fafc !important; /* Tailwindのslate-50くらい */
        }
        
        body.gimmick-active .text-cyan-600 {
            color: #67e8f9 !important; /* cyan-300: 暗い背景で映える水色に */
        }
        
        body.gimmick-active h2.text-gray-800 {
            color: #ffffff !important;
        }

        body.gimmick-active .border-gray-100,
        body.gimmick-active .border-gray-50 {
            border-color: rgba(255, 255, 255, 0.1) !important;
        }
        
        body.gimmick-active .bg-gray-50 {
            background-color: transparent !important;
        }

        /* ヘッダーの色も少し透明にして馴染ませる */
        body.gimmick-active header {
            background-color: rgba(6, 182, 212, 0.8) !important; /* cyan-500の透過 */
            backdrop-filter: blur(8px);
        }
    </style>
</head>

