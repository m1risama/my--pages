    <script>
        // --- 1. 誕生日カウントダウンのプログラム ---
        function updateCountdown() {
            const now = new Date();
            const currentYear = now.getFullYear();
            
            // 11月15日の0時0分0秒を設定
            let nextBirthday = new Date(currentYear, 10, 15, 0, 0, 0); 
            
            const isBirthday = now.getMonth() === 10 && now.getDate() === 15;

            const timerElement = document.getElementById('bday-timer');
            const messageElement = document.getElementById('bday-message');

            if (isBirthday) {
                timerElement.style.display = 'none';
                messageElement.innerHTML = "🎉 <b>今日は誕生日です！おめでとうございます！</b> 🎉";
                messageElement.className = "mt-4 text-pink-500 font-bold text-xl h-auto";
                return;
            }

            if (now.getTime() > nextBirthday.getTime() && !isBirthday) {
                nextBirthday = new Date(currentYear + 1, 10, 15, 0, 0, 0);
            }

            const diffTime = nextBirthday.getTime() - now.getTime();

            const days = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diffTime % (1000 * 60)) / 1000);

            document.getElementById('bday-days').textContent = days;
            document.getElementById('bday-hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('bday-minutes').textContent = String(minutes).padStart(2, '0');
            document.getElementById('bday-seconds').textContent = String(seconds).padStart(2, '0');
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);

        // --- 2. スクロールアニメーションのプログラム ---
        const observerOptions = {
            root: null,
            // 画面の下から50px入った所で発火させる
            rootMargin: '0px 0px -50px 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // 要素が画面に入ったら、透明(opacity-0)と下ズレ(translate-y-10)のクラスを消す
                    entry.target.classList.remove('opacity-0', 'translate-y-10');
                    // 代わりに不透明(opacity-100)と定位置(translate-y-0)のクラスを付ける
                    entry.target.classList.add('opacity-100', 'translate-y-0');
                    
                    // 一度表示させたら監視を解除する（スクロールを戻しても消えないようにする）
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // 「js-scroll-animate」クラスが付いている要素をすべて監視対象にする
        document.querySelectorAll('.js-scroll-animate').forEach((element) => {
            observer.observe(element);
        });
    </script>
</body>
</html>
