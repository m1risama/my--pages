    <!-- プログラム部分 -->
    <script>
        // --- 1. 誕生日カウントダウンのプログラム ---
        function updateCountdown() {
            const now = new Date();
            const currentYear = now.getFullYear();
            
            // 11月15日の0時0分0秒を設定
            let nextBirthday = new Date(currentYear, 10, 15, 0, 0, 0); 
            
            const isBirthday = now.getMonth() === 10 && now.getDate() === 15;

            const timerElement = document.getElementById('bday-timer');
            const messageElement = document.getElementById('bday-message');

            if (isBirthday) {
                timerElement.style.display = 'none';
                messageElement.innerHTML = "🎉 <b>今日は誕生日です！おめでとうございます！</b> 🎉";
                messageElement.className = "mt-4 text-pink-500 font-bold text-xl h-auto";
                return;
            }

            if (now.getTime() > nextBirthday.getTime() && !isBirthday) {
                nextBirthday = new Date(currentYear + 1, 10, 15, 0, 0, 0);
            }

            const diffTime = nextBirthday.getTime() - now.getTime();

            const days = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diffTime % (1000 * 60)) / 1000);

            document.getElementById('bday-days').textContent = days;
            document.getElementById('bday-hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('bday-minutes').textContent = String(minutes).padStart(2, '0');
            document.getElementById('bday-seconds').textContent = String(seconds).padStart(2, '0');
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);

        // --- 2. スクロールアニメーションのプログラム ---
        const observerOptions = {
            root: null,
            // 画面の下から50px入った所で発火させる
            rootMargin: '0px 0px -50px 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    // 要素が画面に入ったら、透明(opacity-0)と下ズレ(translate-y-10)のクラスを消す
                    entry.target.classList.remove('opacity-0', 'translate-y-10');
                    // 代わりに不透明(opacity-100)と定位置(translate-y-0)のクラスを付ける
                    entry.target.classList.add('opacity-100', 'translate-y-0');
                    
                    // 一度表示させたら監視を解除する（スクロールを戻しても消えないようにする）
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // 「js-scroll-animate」クラスが付いている要素をすべて監視対象にする
        document.querySelectorAll('.js-scroll-animate').forEach((element) => {
            observer.observe(element);
        });

        // --- 3. ドロップダウンメニューの開閉プログラム ---
        const menuToggleBtn = document.getElementById('menu-toggle-btn');
        const iconMenu = document.getElementById('icon-menu');
        const iconClose = document.getElementById('icon-close');
        const dropdownMenu = document.getElementById('dropdown-menu');
        const menuLinks = document.querySelectorAll('.js-menu-link');

        function toggleMenu() {
            const isClosed = dropdownMenu.classList.contains('invisible');
            if (isClosed) {
                // メニューを開く
                dropdownMenu.classList.remove('invisible', 'opacity-0', 'scale-95');
                dropdownMenu.classList.add('visible', 'opacity-100', 'scale-100');
                // アイコンを×に変更
                iconMenu.classList.add('hidden');
                iconClose.classList.remove('hidden');
            } else {
                // メニューを閉じる
                dropdownMenu.classList.add('invisible', 'opacity-0', 'scale-95');
                dropdownMenu.classList.remove('visible', 'opacity-100', 'scale-100');
                // アイコンを三本線に戻す
                iconMenu.classList.remove('hidden');
                iconClose.classList.add('hidden');
            }
        }

        // ボタンクリックでトグル
        menuToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation(); // イベントのバブリングを防ぐ（ドキュメントクリックで閉じないように）
            toggleMenu();
        });

        // リンクをクリックしたら自動的に閉じる
        menuLinks.forEach(link => {
            link.addEventListener('click', toggleMenu);
        });

        // メニューの外側をクリックしたら閉じる
        document.addEventListener('click', (e) => {
            if (!dropdownMenu.classList.contains('invisible') && !dropdownMenu.contains(e.target) && !menuToggleBtn.contains(e.target)) {
                toggleMenu();
            }
        });

        // --- 4. 隠しギミック（ダブルクリックで3秒間 背景画像＆文字白化） ---
        let lastClickTime = 0;
        const bodyElement = document.body;

        // 画面上のどこかをクリックした時の処理
        document.addEventListener('click', (e) => {
            const currentTime = new Date().getTime();
            const timeDiff = currentTime - lastClickTime;

            // 前回のクリックから0.5秒以内（500ミリ秒以内）ならダブルクリックと判定
            if (timeDiff > 0 && timeDiff <= 500) {
                // すでにギミック発動中なら何もしない
                if(bodyElement.classList.contains('gimmick-active')){
                    return;
                }

                // bodyにギミック発動クラスをつける
                bodyElement.classList.add('gimmick-active');

                // 3秒後に元に戻す
                setTimeout(() => {
                    bodyElement.classList.remove('gimmick-active');
                }, 3000);

                // ダブルクリック判定のリセット
                lastClickTime = 0;
            } else {
                // 1回目のクリック時間を記録
                lastClickTime = currentTime;
            }
        });

    </script>
