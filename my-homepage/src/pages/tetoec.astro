<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TETOECにて映像を制作 | みりのサイト</title>
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- ヘッダー -->
    <header class="bg-cyan-500 py-6 shadow-md">
        <div class="container mx-auto px-4 max-w-4xl">
            <h1 class="text-3xl font-bold text-left">
                <a href="/" class="text-white hover:text-cyan-100 transition-colors duration-300">みりのサイト</a>
            </h1>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="container mx-auto px-4 py-10 max-w-4xl">
        
        <!-- 戻るボタン -->
        <a href="/" class="inline-flex items-center text-cyan-600 hover:text-cyan-800 font-bold mb-8 transition-colors group">
            <span class="transform group-hover:-translate-x-1 transition-transform duration-300">←</span>
            <span class="ml-2">トップページに戻る</span>
        </a>

        <!-- 記事のボックス -->
        <article class="bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-gray-200">
            
            <!-- 記事のタイトル部分 -->
            <div class="mb-10 border-b border-gray-100 pb-8">
                <div class="text-sm text-cyan-600 font-bold mb-3">2026年 8月8日・9日</div>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4 leading-tight">
                    TETOECにて映像を制作
                </h1>
                <p class="text-gray-500 text-lg">
                    VLL主催のイベントのTETOECでオーバーライドの上映像を制作 
                    下が作った映像です
                </p>
            </div>

            <!-- 本文エリア (動画のみにシンプル化) -->
            <div class="text-gray-700 leading-relaxed space-y-8 text-lg">
                
                <!-- セクション: 制作した動画 -->
                <div>
                    <!-- 動画プレーヤー -->
                    <div class="w-full aspect-video rounded-xl overflow-hidden shadow-sm bg-black">
                        <video class="w-full h-full object-contain" controls playsinline>
                            <!-- ★今のファイル名をそのまま指定しました！ -->
                            <source src="/over.mp4" type="video/mp4">
                            お使いのブラウザは動画の再生に対応していません。
                        </video>
                    </div>
                </div>

            </div>
        </article>

    </main>
</body>
</html>